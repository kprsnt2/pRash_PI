# ---------------------------------------------------------------------------
# pRash AI Chat — environment configuration
# Copy this file to `.env.local` and fill in the keys you have.
# You only need the keys for the providers you want to use. Routing will
# automatically skip providers whose key is missing.
# ---------------------------------------------------------------------------

# OpenAI (default / primary provider)
# NOTE: data sent to OpenAI may be used per your account settings. When the
# "Private / temporary" toggle is ON, the app routes to Gemini only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma separated list. ONLY these models are listed in the picker.
OPENAI_MODELS=gpt-5-mini,gpt-5-nano,gpt-5,gpt-4.1-mini
# Optional: pin which model is the default for this provider (bypasses the
# first entry of the list above). Must be reachable on your account.
OPENAI_DEFAULT_MODEL=

# Google Gemini (backup + the ONLY provider used in private mode)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-flash-latest
GEMINI_DEFAULT_MODEL=

# NVIDIA NIM (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODELS=meta/llama-3.3-70b-instruct,meta/llama-3.1-8b-instruct,deepseek-ai/deepseek-r1
NVIDIA_DEFAULT_MODEL=

# Groq (OpenAI-compatible, very fast, generous free tier)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,qwen/qwen3-32b
GROQ_DEFAULT_MODEL=

# Optional: simple passcode gate for the whole app. Leave empty to disable.
APP_PASSCODE=

# Optional: override the automatic fallback order (comma separated "provider:model")
# AUTO_ROUTE=openai:gpt-5-mini,openai:gpt-5-nano,gemini:gemini-flash-latest,groq:llama-3.3-70b-versatile,nvidia:meta/llama-3.3-70b-instruct
